---
/**
 * Residential Hub — /residential/
 *
 * Mockup scaffold. All copy is placeholder pending owner answers
 * (see notes/residential-launch-owner-questionnaire.md in the vault).
 *
 * Design language mirrors the commercial homepage (uppercase H1, tight tracking,
 * font-black, commercial card geometry, border-left FAQ, two-column bottom CTA)
 * but uses the lighter residential palette (white + brand mint, sage-deep CTAs).
 */
import ResidentialLayout from '../../layouts/ResidentialLayout.astro';
import HVACBusinessSchema from '../../components/schema/HVACBusinessSchema.astro';
import { siteConfig } from '../../config/site.config';

const res = siteConfig.residential;
const canonicalURL = new URL('/residential/', Astro.site).toString();

const differentiators = [
  {
    title: 'Same techs the hospitals call.',
    body: 'The crews that restore HVAC for hospitals, schools, and federal facilities are now the ones answering the phone for your home. Same training, same standards, same Building and Air.',
  },
  {
    title: 'Family run, based in Pine Grove.',
    body: 'We live in Schuylkill County. Our kids go to school here. When you call, you reach a neighbor, not a call center three states away.',
  },
  {
    title: 'NADCA certified duct cleaning.',
    body: 'No other home HVAC company in this part of Pennsylvania holds NADCA certification. We do. It is the same standard hospitals and schools demand, now applied to your ductwork.',
  },
  {
    title: 'You see the price before we start.',
    body: 'No surprise upsells once the truck is in your driveway. You get the number in writing, you say yes, then we start the work. That is it.',
  },
];

const faq = [
  {
    question: 'What areas do you serve for residential HVAC in Pennsylvania?',
    answer: 'We are based in Pine Grove and serve homeowners across Schuylkill, Berks, Lebanon, and Dauphin counties. That includes Pottsville, Schuylkill Haven, Reading, Lebanon, Hershey, Pottstown, Hamburg, Orwigsburg, and the towns in between. If you are not sure whether your address is in our area, call (570) 900-5827 and we will tell you straight.',
  },
  {
    question: 'Do you offer free estimates on new systems?',
    answer: 'Yes. Estimates for new AC, furnace, heat pump, and ductless mini split installations are free. We come out, look at your current setup, size the new system to the actual square footage of your home, and hand you a written quote. No deposit, no obligation.',
  },
  {
    question: 'How fast can you get to my home if my system stops working?',
    answer: 'For active maintenance plan members, we offer priority dispatch and after hours service when the heat or AC goes out. For everyone else, we do our best to get out the same day or next morning. [PENDING OWNER: response time SLA we will publicly commit to]. Call (570) 900-5827 and we will tell you when we can be there.',
  },
  {
    question: 'Are you licensed and insured in Pennsylvania?',
    answer: 'Yes. Building and Air Maintenance is fully licensed and insured to work on residential HVAC systems in Pennsylvania. We carry general liability and workers comp on every crew, and we are NADCA, OSHA 30, and EPA certified. Ask us to send proof before we start a job and we will.',
  },
  {
    question: 'Do you offer financing on installations?',
    answer: 'Yes, financing is available on most new system installations. We can walk you through the options when we give you the quote, including monthly payment estimates. [PENDING OWNER: financing partner name and approval details].',
  },
  {
    question: 'What brands of equipment do you install?',
    answer: 'We install high efficiency systems from major American manufacturers and match the brand to your home, budget, and Pennsylvania climate. [PENDING OWNER: top brands installed for residential]. We are not locked into one brand, which means we recommend what is right for your house, not what we are trying to move off the truck.',
  },
];

const breadcrumbs = [{ name: 'Residential', url: '/residential/' }];

const residentialServiceIcons: Record<string, string> = {
  'ac-repair':       `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M12 2v20"/><path d="m4.93 4.93 14.14 14.14"/><path d="m19.07 4.93-14.14 14.14"/></svg>`,
  'ac-install':      `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h2"/><path d="M6 14h2"/><path d="M11 10h2"/><path d="M11 14h2"/><path d="M16 10h2"/></svg>`,
  'furnace-repair':  `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
  'furnace-install': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 8h6"/><path d="M9 13c1 1 2 1 3 1s2 0 3-1"/><circle cx="12" cy="17" r="1"/></svg>`,
  'heat-pump':       `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9a4 4 0 0 0-2 7.5"/><path d="M12 3v2"/><path d="m6.6 18.4-1.4 1.4"/><path d="M20 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>`,
  'mini-split':      `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="9" rx="2"/><path d="M6 18c1-1 2-1 3 0s2 1 3 0 2-1 3 0 2 1 3 0"/></svg>`,
  'duct-cleaning':   `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>`,
  'iaq':             `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96a1 1 0 0 1 1.6.8c0 5.52-2.36 10.06-7.32 12.4A7 7 0 0 1 11 20Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>`,
  'maintenance':     `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  'emergency':       `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
};
---

<ResidentialLayout
  title="Residential HVAC in Schuylkill County, PA | Building and Air"
  description="Family run heating, cooling, and indoor air quality for homeowners across Schuylkill, Berks, Lebanon, and Dauphin counties. NADCA certified, licensed, insured. Call (570) 900-5827."
  canonicalURL={canonicalURL}
>
  <HVACBusinessSchema slot="head" canonicalURL={canonicalURL} breadcrumbs={breadcrumbs} />

  <!-- ═══════════════════════════════════════════════════════════════
       HERO — mirror commercial homepage hero composition
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative w-full py-20 md:py-0 md:h-[90vh] md:min-h-[760px] flex flex-col items-center justify-center font-sans overflow-hidden res-bg-warm">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600210492493-0946911123ea?auto=format&fit=crop&w=1440&q=60"
        alt="Warm sunlit family living room"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(255,255,255,0.82) 0%, rgba(255,255,255,0.62) 50%, rgba(255,255,255,0.95) 100%);"></div>
      <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>
    </div>

    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 flex flex-col items-center text-center">
      <div class="mb-4 md:mb-7 flex items-center gap-3 animate-fade-in-up opacity-0" style="animation-delay: 0ms;">
        <div class="w-2 h-2 rounded-full bg-[var(--color-sage-deep)] animate-pulse"></div>
        <span class="font-bold text-[10px] md:text-xs tracking-[0.3em] uppercase res-text-sage">Family Run Since 2020</span>
      </div>

      <h1 class="text-[2rem] md:text-[3.5rem] lg:text-[4.5rem] font-black leading-[0.88] tracking-tighter res-text-ink mb-6 md:mb-10 animate-fade-in-up opacity-0 uppercase drop-shadow-sm" style="animation-delay: 100ms;">
        Home HVAC,<br class="hidden md:inline" />
        <span class="res-text-sage">Built to a Hospital</span><br />
        Standard.
      </h1>

      <p class="text-[14px] md:text-lg res-text-slate max-w-2xl leading-relaxed font-light mb-8 md:mb-14 opacity-0 animate-fade-in-up" style="animation-delay: 200ms;">
        Same techs the hospitals call, now in your home. Heating, cooling, and clean air for homeowners across Schuylkill, Berks, Lebanon, and Dauphin counties. Family run out of Pine Grove. NADCA certified. You see the price before we start.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-4 animate-fade-in-up opacity-0 w-full justify-center" style="animation-delay: 300ms;">
        <a
          href="#residential-quote"
          class="res-btn-primary inline-flex items-center justify-center gap-3 font-bold tracking-widest text-xs py-4 md:py-[18px] px-8 md:px-10 rounded-sm w-full sm:w-auto sm:min-w-[240px] uppercase no-underline"
        >
          {res.ctaLabel}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href={`tel:${res.phoneRaw}`}
          class="hidden sm:flex items-center justify-center gap-3 px-10 py-[18px] bg-white border-2 res-text-ink font-bold text-xs tracking-widest uppercase hover:bg-[var(--color-sage-deep)] hover:text-white transition-all rounded-sm min-w-[240px] shadow-md no-underline group"
          style="border-color: var(--color-sage-deep);"
        >
          Call {res.phone}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="res-text-sage group-hover:text-white transition-colors"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>

      <a href={`tel:${res.phoneRaw}`} class="sm:hidden inline-flex items-center gap-1.5 res-text-sage hover:opacity-80 text-xs font-bold tracking-wider uppercase no-underline transition-colors mt-5 animate-fade-in-up opacity-0" style="animation-delay: 400ms;">
        Call {res.phone}
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       QUICK QUOTE STRIP — anchored from hero CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section id="residential-quote" class="w-full res-bg-cream border-y res-border-cream py-14 md:py-16 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <div class="text-center mb-8 md:mb-10">
        <span class="inline-block font-bold text-[10px] tracking-[0.3em] uppercase mb-3 res-text-sage">Free Home Estimate</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95]">
          Tell us what is going on.
        </h2>
        <p class="text-base md:text-lg res-text-slate max-w-xl mx-auto mt-4 leading-relaxed">
          A real person reads every message. We call you back within one business day. No spam, no pressure, no auto reply chain.
        </p>
      </div>

      <form name="residential-hero-quote" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="bg-white border res-border-cream rounded-lg p-6 md:p-8 shadow-[0_24px_60px_-24px_rgba(38,90,74,0.18)] space-y-4">
        <input type="hidden" name="form-name" value="residential-hero-quote" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <label for="rh-name" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Full Name *</label>
            <input type="text" id="rh-name" name="name" required placeholder="Jane Smith" class="w-full bg-white border res-border-cream rounded res-text-ink px-3.5 py-2.5 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
          </div>
          <div class="space-y-1.5">
            <label for="rh-phone" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Phone *</label>
            <input type="tel" id="rh-phone" name="phone" required placeholder="(570) 555-1234" class="w-full bg-white border res-border-cream rounded res-text-ink px-3.5 py-2.5 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="rh-service" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Service Needed</label>
          <select id="rh-service" name="service" class="w-full bg-white border res-border-cream rounded res-text-ink px-3.5 py-2.5 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all">
            <option value="">Choose one</option>
            {res.services.map((s) => (
              <option value={s.slug}>{s.title}</option>
            ))}
            <option value="not-sure">Not sure yet</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="rh-summary" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Brief Description</label>
          <textarea id="rh-summary" name="summary" rows="3" placeholder="Tell us what your system is doing (or not doing)." class="w-full bg-white border res-border-cream rounded res-text-ink px-3.5 py-2.5 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400 resize-none"></textarea>
        </div>

        <button type="submit" class="res-btn-primary w-full px-6 py-4 rounded-sm font-bold tracking-[0.22em] uppercase text-xs">
          {res.ctaLabel}
        </button>
      </form>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICES GRID — mirror commercial card geometry, lighter palette
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-10 lg:px-16">
      <div class="text-center mb-10 md:mb-12">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          What we do for homeowners
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-[54px] font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Ten Services. One Crew.<br/>One Phone Number.
        </h2>
        <div class="w-24 h-1.5 mx-auto opacity-30 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-5">
        {res.services.map((service) => (
          <a
            href={`/residential/${service.slug}/`}
            class="group relative rounded-xl p-6 pt-7 transition-all duration-300 h-full flex flex-col no-underline overflow-hidden hover:-translate-y-1.5 bg-white border border-[var(--color-warm-line)] hover:border-[var(--color-sage-deep)]/30 shadow-[0_2px_16px_rgba(38,90,74,0.06)] hover:shadow-[0_16px_40px_rgba(38,90,74,0.14)]"
          >
            <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[var(--color-sage)] to-[var(--color-sage-deep)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <div class="relative z-10 mb-5 w-11 h-11 rounded-lg flex items-center justify-center transition-colors duration-300" style="background-color: rgba(167, 215, 197, 0.25); color: var(--color-sage-deep);">
              <Fragment set:html={residentialServiceIcons[service.id] || residentialServiceIcons['maintenance']} />
            </div>

            <h3 class="relative z-10 text-[15px] font-extrabold uppercase tracking-tight leading-snug res-text-ink mb-2.5">
              {service.title}
            </h3>
            <p class="relative z-10 text-[13px] res-text-slate leading-relaxed flex-grow">
              {service.shortDescription}
            </p>

            <div class="relative z-10 mt-6 pt-4 border-t border-[var(--color-warm-line)] flex items-center font-bold text-[11px] uppercase tracking-widest res-text-sage transition-colors duration-300">
              <span>Learn More</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-auto opacity-40 group-hover:opacity-90 transition-all duration-300 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       DIFFERENTIATORS — Why neighbors call us first
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-warm py-14 md:py-18 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="text-center mb-10 md:mb-12">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Why neighbors call us first
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-[54px] font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          You Should Not Have to Wonder<br/>Who Is in Your House.
        </h2>
        <p class="text-base md:text-lg res-text-slate max-w-2xl mx-auto mt-5 leading-relaxed">
          Four reasons homeowners in Pottsville, Pine Grove, Reading, and Lebanon keep our number on the fridge instead of the other guy's.
        </p>
        <div class="w-24 h-1 mx-auto mt-6 opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {differentiators.map((d, i) => (
          <div class="group rounded-lg border border-[var(--color-warm-line)] bg-white p-8 md:p-10 transition-all duration-300 hover:border-[var(--color-sage-deep)]/40 hover:shadow-[0_14px_40px_-12px_rgba(38,90,74,0.18)]">
            <div class="flex items-center gap-4 mb-5">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-300" style="background-color: rgba(167, 215, 197, 0.3); color: var(--color-sage-deep);">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="text-[11px] font-bold tracking-[0.25em] uppercase res-text-sage opacity-70">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold res-text-ink mb-3 leading-tight">{d.title}</h3>
            <p class="res-text-slate text-base md:text-lg leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICE AREA — counties + cities
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-cream py-14 md:py-18">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Where we work
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Counties We Serve.
        </h2>
        <div class="w-20 h-1 mb-6 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
        <p class="text-base md:text-lg leading-relaxed res-text-slate mb-7 max-w-md">
          We are based in Pine Grove and run residential calls across four Pennsylvania counties. Same crews, same trucks, the whole footprint. If your address is anywhere in this map, we can be at your door.
        </p>
        <ul class="grid grid-cols-2 gap-3 mb-8">
          {res.serviceAreaCounties.map((c) => (
            <li class="flex items-center gap-2 text-base res-text-ink">
              <span class="w-2 h-2 rounded-full" style="background-color: var(--color-sage-deep);"></span>
              <span class="font-semibold">{c} County</span>
            </li>
          ))}
        </ul>
        <p class="text-[10px] font-bold tracking-[0.22em] uppercase res-text-sage mb-3">Cities we work in most often</p>
        <ul class="flex flex-wrap gap-2">
          {res.serviceAreaCities.map((c) => (
            <li>
              <a
                href={`/residential/locations/${c.slug}/`}
                class="inline-block res-bg-surface border res-border-cream px-3.5 py-1.5 rounded-full text-sm font-semibold res-text-ink no-underline hover:border-[var(--color-sage-deep)] hover:res-text-sage transition-colors"
              >{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-md res-bg-surface">
        <iframe
          src="https://www.google.com/maps?q=Pine+Grove,+PA&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="BAM Residential service area map"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       FAQ — mirrors commercial border-left pattern, light palette
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-warm py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-dots"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="text-center mb-10 md:mb-12">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Questions homeowners ask us
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Frequently Asked Questions
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>

      <div class="space-y-10 md:space-y-12">
        {faq.map((q) => (
          <details class="group border-l-2 pl-6 md:pl-8" style="border-color: rgba(38, 90, 74, 0.4);">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
              <h3 class="text-lg md:text-xl font-bold res-text-ink leading-snug">{q.question}</h3>
              <span class="res-text-sage flex-shrink-0 text-xl leading-none mt-1 transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="res-text-slate text-base md:text-lg leading-relaxed mt-4">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       BOTTOM CTA — two columns, mirrors commercial /index.astro
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-12 lg:px-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

        <!-- LEFT: copy + value props -->
        <div class="flex flex-col space-y-7">
          <div>
            <span class="font-bold text-[10px] tracking-[0.22em] uppercase mb-4 block res-text-sage">
              Ready when you are
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-[54px] font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5 max-w-xl">
              Get a Free<br/>Home Estimate.
            </h2>
            <p class="res-text-slate text-base md:text-lg leading-relaxed max-w-xl">
              Tell us what your system is doing or not doing. We will give you a straight answer, a written price, and a real date we can be at your house. No deposit, no obligation.
            </p>
          </div>

          <ul class="space-y-5 mt-1">
            {[
              { title: 'A Real Person Picks Up', description: 'A neighbor answers the phone in Pine Grove. No phone tree, no overseas call center, no auto reply chain.' },
              { title: 'Price in Writing, Up Front', description: 'You see the number before we cut a wire. No add ons in the driveway, no surprise charges at the end of the visit.' },
              { title: 'NADCA Certified Standards', description: 'The same indoor air quality and duct cleaning standards hospitals require, now applied to your house.' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-7 h-7 rounded-full flex items-center justify-center mt-1 flex-shrink-0" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <p class="res-text-ink text-sm font-bold uppercase tracking-[0.14em]">{item.title}</p>
                  <p class="res-text-slate text-sm md:text-base leading-relaxed mt-1">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3 mt-2">
            <div class="p-2.5 rounded-full" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] uppercase tracking-[0.28em] res-text-slate font-semibold">Direct Line</span>
              <a href={`tel:${res.phoneRaw}`} class="text-sm font-bold res-text-ink hover:res-text-sage transition-colors">{res.phone}</a>
            </div>
          </div>
        </div>

        <!-- RIGHT: form -->
        <div class="w-full lg:max-w-xl lg:ml-auto">
          <div class="res-bg-surface border res-border-cream rounded-lg p-6 md:p-8 shadow-[0_24px_60px_-24px_rgba(38,90,74,0.20)]">
            <div class="h-1 w-16 rounded-full mb-4" style="background-color: var(--color-sage-deep);"></div>
            <div class="mb-6">
              <h3 class="res-text-ink font-bold text-base uppercase tracking-[0.12em]">
                Free Estimate Request
              </h3>
              <p class="res-text-slate text-xs md:text-sm mt-2 leading-relaxed">
                Fill in the details below. A real person reads every message and calls you back within one business day.
              </p>
            </div>

            <form name="residential-bottom-quote" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value="residential-bottom-quote" />
              <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

              <div class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="rb-name" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Full Name *</label>
                    <input type="text" id="rb-name" name="name" required placeholder="Jane Smith" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                  <div class="space-y-1.5">
                    <label for="rb-phone" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Phone *</label>
                    <input type="tel" id="rb-phone" name="phone" required placeholder="(570) 555-1234" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="rb-email" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Email</label>
                  <input type="email" id="rb-email" name="email" placeholder="jane@example.com" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                </div>

                <div class="space-y-1.5">
                  <label for="rb-service" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Service Needed</label>
                  <select id="rb-service" name="service" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all">
                    <option value="">Choose one</option>
                    {res.services.map((s) => (
                      <option value={s.slug}>{s.title}</option>
                    ))}
                    <option value="not-sure">Not sure yet</option>
                  </select>
                </div>

                <div class="space-y-1.5">
                  <label for="rb-message" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Message</label>
                  <textarea id="rb-message" name="message" rows="4" placeholder="Tell us what is happening with your system." class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400 resize-none"></textarea>
                </div>
              </div>

              <div class="mt-6">
                <button type="submit" class="res-btn-primary w-full px-8 py-4 rounded-sm font-bold tracking-[0.22em] uppercase text-sm">
                  {res.ctaLabel}
                </button>
              </div>
            </form>

            <p class="text-[10px] res-text-slate mt-4 leading-relaxed">
              No spam, no pressure pitch, no auto reply chain. A real person reads every message.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</ResidentialLayout>
