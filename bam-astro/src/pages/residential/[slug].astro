---
/**
 * Residential Service Template — /residential/[slug]/
 *
 * Generates 10 service pages from siteConfig.residential.services. All copy
 * is placeholder pending owner answers. Design language mirrors the commercial
 * service / homepage patterns: uppercase H1, tight tracking, commercial card
 * geometry, border-left FAQ, two-column bottom CTA with embedded form. Lighter
 * sage-and-white palette.
 */
import ResidentialLayout from '../../layouts/ResidentialLayout.astro';
import ResidentialServiceSchema from '../../components/schema/ResidentialServiceSchema.astro';
import { siteConfig } from '../../config/site.config';

export async function getStaticPaths() {
  return siteConfig.residential.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const res = siteConfig.residential;
const canonicalURL = new URL(`/residential/${service.slug}/`, Astro.site).toString();

const breadcrumbs = [
  { name: 'Residential', url: '/residential/' },
  { name: service.title, url: `/residential/${service.slug}/` },
];

// Placeholder symptom list — owner will confirm per service
const symptoms = [
  '[PLACEHOLDER] Your system is making a new noise',
  '[PLACEHOLDER] Some rooms feel warmer or colder than others',
  '[PLACEHOLDER] You notice a smell when the system runs',
  '[PLACEHOLDER] Your electric bill jumped this month',
  '[PLACEHOLDER] The system runs constantly and never catches up',
];

const included = [
  '[PLACEHOLDER] A full diagnostic visit, no high-pressure sales',
  '[PLACEHOLDER] Up-front pricing before any work begins',
  '[PLACEHOLDER] Cleanup that leaves your home better than we found it',
  '[PLACEHOLDER] Written summary of what we found and what we did',
];

// Friendly homeowner-facing version of The BAM Method
const process = [
  { num: '01', title: 'You call.', body: '[PLACEHOLDER] We answer. A real person, no phone tree.' },
  { num: '02', title: 'We listen.', body: '[PLACEHOLDER] You tell us what is going on. We ask the right questions.' },
  { num: '03', title: 'We come out.', body: '[PLACEHOLDER] We show up when we said we would, in a marked truck, in uniform.' },
  { num: '04', title: 'We fix it.', body: '[PLACEHOLDER] Straight price up front. We get the work done, clean up, and stand behind it.' },
];

const faq = [
  {
    question: `[PLACEHOLDER] How much does ${service.title.toLowerCase()} cost in Pennsylvania?`,
    answer: '[PLACEHOLDER pricing posture pending owner confirmation]',
  },
  {
    question: `[PLACEHOLDER] How long does ${service.title.toLowerCase()} usually take?`,
    answer: '[PLACEHOLDER copy pending owner answers]',
  },
  {
    question: '[PLACEHOLDER] Do you offer financing on installs?',
    answer: '[PLACEHOLDER pending owner confirmation of financing partner]',
  },
  {
    question: '[PLACEHOLDER] What is the warranty on your work?',
    answer: '[PLACEHOLDER pending owner confirmation of labor warranty terms]',
  },
];
---

<ResidentialLayout
  title={`[PLACEHOLDER] ${service.title} for Homeowners | BAM`}
  description={`[PLACEHOLDER] ${service.title} services for homeowners across Schuylkill, Berks, Lebanon, and Dauphin counties.`}
  canonicalURL={canonicalURL}
>
  <ResidentialServiceSchema
    slot="head"
    canonicalURL={canonicalURL}
    serviceName={service.title}
    serviceDescription={service.shortDescription}
    breadcrumbs={breadcrumbs}
    faq={faq}
  />

  <!-- ═══════════════════════════════════════════════════════════════
       HERO — uppercase, font-black, embedded mini lead form, fits viewport
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative w-full res-bg-warm overflow-hidden min-h-[calc(100vh-72px)] flex items-center py-8 md:py-10">
    <div class="absolute inset-0 opacity-[0.05] site-grid-dots"></div>
    <div class="absolute -top-32 -right-32 w-[460px] h-[460px] rounded-full opacity-25 pointer-events-none" style="background-color: var(--color-sage);"></div>
    <div class="absolute -bottom-40 -left-32 w-[380px] h-[380px] rounded-full opacity-20 pointer-events-none" style="background-color: var(--color-sage);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10 grid lg:grid-cols-[1.15fr_1fr] gap-8 lg:gap-14 items-center">

      <!-- LEFT: breadcrumb + H1 + CTAs -->
      <div>
        <nav class="text-[11px] res-text-slate mb-5 flex items-center gap-2 flex-wrap font-semibold tracking-wider uppercase" aria-label="Breadcrumb">
          <a href="/" class="hover:res-text-sage res-text-slate no-underline transition-colors">Home</a>
          <span class="opacity-50">/</span>
          <a href="/residential/" class="hover:res-text-sage res-text-slate no-underline transition-colors">Residential</a>
          <span class="opacity-50">/</span>
          <span class="res-text-ink">{service.title}</span>
        </nav>

        <div class="mb-4 md:mb-5 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-[var(--color-sage-deep)] animate-pulse"></div>
          <span class="font-bold text-[10px] md:text-xs tracking-[0.22em] uppercase res-text-sage">
            For homeowners
          </span>
        </div>

        <h1 class="text-[2rem] sm:text-4xl md:text-5xl lg:text-[4rem] font-black uppercase tracking-tighter leading-[0.92] res-text-ink mb-5 md:mb-6">
          {service.title}<br/>
          <span class="res-text-sage">You Can</span> <br class="hidden md:inline"/>
          Actually Count On.
        </h1>

        <p class="text-base md:text-lg leading-relaxed res-text-slate max-w-xl mb-6 md:mb-8">
          {service.shortDescription}
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a href="#service-quote" class="res-btn-primary inline-flex items-center justify-center gap-3 px-7 md:px-8 py-4 rounded-sm font-bold tracking-widest text-xs uppercase no-underline">
            {res.ctaLabel}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href={`tel:${res.phoneRaw}`} class="res-btn-secondary inline-flex items-center justify-center gap-3 px-7 md:px-8 py-4 rounded-sm font-bold tracking-widest text-xs uppercase no-underline">
            Call {res.phone}
          </a>
        </div>
      </div>

      <!-- RIGHT: trust quick-card -->
      <div class="hidden lg:block">
        <div class="res-bg-surface border res-border-cream rounded-lg p-7 shadow-[0_24px_60px_-24px_rgba(38,90,74,0.20)]">
          <div class="h-1 w-12 bg-[var(--color-sage-deep)] rounded-full mb-4"></div>
          <h2 class="text-base font-bold uppercase tracking-[0.14em] res-text-ink mb-5">
            What you can expect
          </h2>
          <ul class="space-y-4">
            {[
              { label: 'Same-day response', desc: 'A real person picks up the phone.' },
              { label: 'Up-front pricing', desc: 'You get the number before we start.' },
              { label: 'NADCA certified', desc: 'Hospital-grade standards at home.' },
              { label: 'Licensed and insured', desc: 'Fully covered in Pennsylvania.' },
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <div>
                  <p class="res-text-ink text-sm font-bold uppercase tracking-[0.12em]">{item.label}</p>
                  <p class="res-text-slate text-sm leading-relaxed mt-0.5">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       WHAT IS INCLUDED — commercial-style cards on light bg
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-10">
      <div class="text-center mb-12 md:mb-14">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          What you get
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          What Is Included.
        </h2>
        <div class="w-20 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {included.map((item) => (
          <li class="relative rounded-xl p-6 bg-white border border-[var(--color-warm-line)] flex items-start gap-4 transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sage-deep)]/30 hover:shadow-[0_14px_30px_-12px_rgba(38,90,74,0.14)]">
            <span class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span class="text-base md:text-lg res-text-ink leading-snug font-semibold">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       WHEN TO CALL US
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-warm py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div>
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Signs to call us
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          When to Call Us.
        </h2>
        <div class="w-20 h-1 mb-6 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
        <p class="text-base md:text-lg leading-relaxed res-text-slate max-w-md">
          [PLACEHOLDER] If any of these sound like your home, give us a call. No pressure, just a straight answer.
        </p>
      </div>
      <ul class="space-y-3">
        {symptoms.map((s) => (
          <li class="flex items-start gap-3 rounded-lg p-4 bg-white border border-[var(--color-warm-line)] transition-all duration-300 hover:border-[var(--color-sage-deep)]/30 hover:shadow-[0_8px_24px_-12px_rgba(38,90,74,0.18)]">
            <span class="w-2 h-2 rounded-full mt-2.5 flex-shrink-0" style="background-color: var(--color-sage-deep);"></span>
            <span class="text-base res-text-ink font-medium">{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       PROCESS — 4-step, commercial card pattern
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          How it works
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          From Your First Call<br/>to a Fixed System.
        </h2>
        <div class="w-20 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {process.map((p) => (
          <div class="group relative rounded-xl p-7 bg-white border border-[var(--color-warm-line)] transition-all duration-300 hover:-translate-y-1.5 hover:border-[var(--color-sage-deep)]/30 hover:shadow-[0_14px_30px_-12px_rgba(38,90,74,0.14)] overflow-hidden">
            <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[var(--color-sage)] to-[var(--color-sage-deep)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-3xl font-black res-text-sage mb-3 tracking-tight">{p.num}</div>
            <h3 class="font-extrabold text-lg uppercase tracking-tight res-text-ink mb-2.5">{p.title}</h3>
            <p class="text-base res-text-slate leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       PRICING POSTURE
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-warm py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-6 md:px-10 res-bg-surface rounded-2xl p-10 md:p-12 text-center border res-border-cream shadow-[0_14px_40px_-12px_rgba(38,90,74,0.14)]">
      <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
        How we price
      </span>
      <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
        Straight Prices. Up Front.
      </h2>
      <div class="w-20 h-1 mx-auto mb-6 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
      <p class="text-base md:text-lg res-text-slate leading-relaxed">
        [PLACEHOLDER pricing posture pending owner confirmation] You get a written price before we start the work. No surprises, no add-ons in the middle of the job.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       LOCAL TRUST SIGNALS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-cream py-20 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10 text-center">
      <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
        Local, licensed, insured
      </span>
      <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
        We Live Here Too.
      </h2>
      <div class="w-20 h-1 mx-auto mb-10 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
        <div class="rounded-xl p-5 bg-white border border-[var(--color-warm-line)]">
          <div class="text-3xl md:text-4xl font-black res-text-sage mb-1 tracking-tight">[ ]</div>
          <div class="text-xs font-bold tracking-[0.14em] uppercase res-text-slate">Years serving PA</div>
        </div>
        <div class="rounded-xl p-5 bg-white border border-[var(--color-warm-line)]">
          <div class="text-3xl md:text-4xl font-black res-text-sage mb-1 tracking-tight">NADCA</div>
          <div class="text-xs font-bold tracking-[0.14em] uppercase res-text-slate">Certified</div>
        </div>
        <div class="rounded-xl p-5 bg-white border border-[var(--color-warm-line)]">
          <div class="text-3xl md:text-4xl font-black res-text-sage mb-1 tracking-tight">[ ]</div>
          <div class="text-xs font-bold tracking-[0.14em] uppercase res-text-slate">Homes serviced</div>
        </div>
        <div class="rounded-xl p-5 bg-white border border-[var(--color-warm-line)]">
          <div class="text-3xl md:text-4xl font-black res-text-sage mb-1 tracking-tight">PA</div>
          <div class="text-xs font-bold tracking-[0.14em] uppercase res-text-slate">Licensed, insured</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICE AREA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-warm py-20 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10 text-center">
      <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
        Where we work
      </span>
      <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
        Towns We Serve.
      </h2>
      <div class="w-20 h-1 mx-auto mb-10 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
      <ul class="flex flex-wrap gap-3 justify-center max-w-3xl mx-auto">
        {res.serviceAreaCities.map((c) => (
          <li>
            <a
              href={`/residential/locations/${c.slug}/`}
              class="inline-block res-bg-surface border res-border-cream px-4 py-2 rounded-full text-base font-semibold res-text-ink no-underline hover:border-[var(--color-sage-deep)] hover:res-text-sage transition-colors"
            >{c.name}, {c.state}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       FAQ — border-left commercial pattern
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="text-center mb-14 md:mb-20">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Questions
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Frequently Asked Questions
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <div class="space-y-10 md:space-y-12">
        {faq.map((q) => (
          <details class="group border-l-2 pl-6 md:pl-8" style="border-color: rgba(38, 90, 74, 0.4);">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
              <h3 class="text-lg md:text-xl font-bold res-text-ink leading-snug">{q.question}</h3>
              <span class="res-text-sage flex-shrink-0 text-xl leading-none mt-1 transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="res-text-slate text-base md:text-lg leading-relaxed mt-4">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       BOTTOM CTA — two columns, embedded form
       ═══════════════════════════════════════════════════════════════ -->
  <section id="service-quote" class="relative res-bg-warm pt-20 pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-dots"></div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-12 lg:px-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

        <div class="flex flex-col space-y-7">
          <div>
            <span class="font-bold text-[10px] tracking-[0.22em] uppercase mb-4 block res-text-sage">
              Ready when you are
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-[54px] font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5 max-w-xl">
              Get a Free<br/>Estimate.
            </h2>
            <p class="res-text-slate text-base md:text-lg leading-relaxed max-w-xl">
              [PLACEHOLDER] We will call you back within one business day with a straight answer and an up-front price.
            </p>
          </div>

          <ul class="space-y-5 mt-1">
            {[
              { title: 'Real Person Answers', description: 'A neighbor picks up the phone, no phone tree.' },
              { title: 'No Surprises', description: 'You get the number before we start the work.' },
              { title: 'Trusted Standards', description: 'Same NADCA standards we apply to hospitals and schools.' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-7 h-7 rounded-full flex items-center justify-center mt-1 flex-shrink-0" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <p class="res-text-ink text-sm font-bold uppercase tracking-[0.14em]">{item.title}</p>
                  <p class="res-text-slate text-sm md:text-base leading-relaxed mt-1">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3 mt-2">
            <div class="p-2.5 rounded-full" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] uppercase tracking-[0.28em] res-text-slate font-semibold">Direct Line</span>
              <a href={`tel:${res.phoneRaw}`} class="text-sm font-bold res-text-ink hover:res-text-sage transition-colors">{res.phone}</a>
            </div>
          </div>
        </div>

        <div class="w-full lg:max-w-xl lg:ml-auto">
          <div class="res-bg-surface border res-border-cream rounded-lg p-6 md:p-8 shadow-[0_24px_60px_-24px_rgba(38,90,74,0.20)]">
            <div class="h-1 w-16 rounded-full mb-4" style="background-color: var(--color-sage-deep);"></div>
            <div class="mb-6">
              <h3 class="res-text-ink font-bold text-base uppercase tracking-[0.12em]">
                Free Estimate Request
              </h3>
              <p class="res-text-slate text-xs md:text-sm mt-2 leading-relaxed">
                Service requested: <span class="font-semibold res-text-ink">{service.title}</span>
              </p>
            </div>

            <form name={`residential-${service.slug}-quote`} method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value={`residential-${service.slug}-quote`} />
              <input type="hidden" name="service" value={service.title} />
              <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

              <div class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="sv-name" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Full Name *</label>
                    <input type="text" id="sv-name" name="name" required placeholder="Jane Smith" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                  <div class="space-y-1.5">
                    <label for="sv-phone" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Phone *</label>
                    <input type="tel" id="sv-phone" name="phone" required placeholder="(570) 555-1234" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="sv-email" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Email</label>
                  <input type="email" id="sv-email" name="email" placeholder="jane@example.com" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                </div>

                <div class="space-y-1.5">
                  <label for="sv-message" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Message</label>
                  <textarea id="sv-message" name="message" rows="4" placeholder={`Tell us what is happening with your system. Service: ${service.title}`} class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400 resize-none"></textarea>
                </div>
              </div>

              <div class="mt-6">
                <button type="submit" class="res-btn-primary w-full px-8 py-4 rounded-sm font-bold tracking-[0.22em] uppercase text-sm">
                  {res.ctaLabel}
                </button>
              </div>
            </form>

            <p class="text-[10px] res-text-slate mt-4 leading-relaxed">
              No spam, no high-pressure sales. We respond to every message.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</ResidentialLayout>
