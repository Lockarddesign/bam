---
/**
 * Residential Location Template — /residential/locations/[city]/
 *
 * Generates a hyperlocal page per city in
 * siteConfig.residential.serviceAreaCities. Map embed is city-specific, not
 * HQ-centered, per the location-page-must-have-local-map rule.
 *
 * Design language mirrors the commercial homepage / service pages: uppercase
 * H1, tight tracking, commercial card geometry, border-left FAQ, two-column
 * bottom CTA with embedded form. Lighter sage-and-white palette.
 *
 * Copy reflects owner answers: Schuylkill County only, NADCA certified
 * preventive air care. No installs, no repairs.
 */
import ResidentialLayout from '../../../layouts/ResidentialLayout.astro';
import ResidentialLocalBusinessSchema from '../../../components/schema/ResidentialLocalBusinessSchema.astro';
import { siteConfig } from '../../../config/site.config';

export async function getStaticPaths() {
  return siteConfig.residential.serviceAreaCities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const res = siteConfig.residential;
const canonicalURL = new URL(`/residential/locations/${city.slug}/`, Astro.site).toString();

const breadcrumbs = [
  { name: 'Residential', url: '/residential/' },
  { name: city.name, url: `/residential/locations/${city.slug}/` },
];

const reviews = siteConfig.testimonials;

const faq = [
  {
    question: `What HVAC services do you offer in ${city.name}?`,
    answer: `Five things, and we do them well. Whole home duct cleaning to the NADCA standard, indoor air quality, dryer vent cleaning, air sampling, and preventive maintenance plans. We do not install or repair equipment. We do not sell furnaces, air conditioners, or heat pumps. Our focus is keeping the system you already own clean, healthy, and running efficiently.`,
  },
  {
    question: `How fast can you get to a home in ${city.name}, ${city.state}?`,
    answer: `We are based in Pine Grove and ${city.name} is in our Schuylkill County service area. We typically respond within a few days, and our hours follow the listing on our Google Business Profile. Call (570) 900-5827 and we will tell you when we can be at your door.`,
  },
  {
    question: `What makes you different from other companies near ${city.name}?`,
    answer: `We are the only NADCA certified company in Schuylkill County. We bring commercial grade restoration and indoor air quality discipline to homes. Source removal, HEPA containment, encapsulation, and lab verified air sampling. The same standards we use in federal facilities and hospital surgical suites, applied to your home.`,
  },
  {
    question: `Are estimates free?`,
    answer: `Yes. Estimates are free. We will look at your system, tell you what we find, and give you a straight price before any work begins.`,
  },
];

const residentialServiceIcons: Record<string, string> = {
  'duct-cleaning':       `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>`,
  'iaq':                 `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19.2 2.96a1 1 0 0 1 1.6.8c0 5.52-2.36 10.06-7.32 12.4A7 7 0 0 1 11 20Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>`,
  'dryer-vent-cleaning': `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2"/><path d="M12.59 19.41A2 2 0 1 0 14 16H2"/><path d="M17.73 7.73A2.5 2.5 0 1 1 19.5 12H2"/></svg>`,
  'air-sampling':        `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v6.5L5.5 17a2 2 0 0 0 1.7 3h9.6a2 2 0 0 0 1.7-3L14 9.5V3"/><path d="M7.5 14h9"/></svg>`,
  'maintenance-plans':   `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
};
---

<ResidentialLayout
  title={`NADCA Certified Home Air Care in ${city.name}, ${city.state} | Building and Air`}
  description={`Whole home duct cleaning, indoor air quality, and preventive maintenance for homeowners in ${city.name}, ${city.state}. The only NADCA certified company in Schuylkill County. Call (570) 900-5827.`}
  canonicalURL={canonicalURL}
>
  <ResidentialLocalBusinessSchema
    slot="head"
    canonicalURL={canonicalURL}
    city={city}
    breadcrumbs={breadcrumbs}
    faq={faq}
  />

  <!-- ═══════════════════════════════════════════════════════════════
       HERO — mirror commercial homepage hero composition
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative w-full py-20 md:py-0 md:h-[90vh] md:min-h-[760px] flex flex-col items-center justify-center font-sans overflow-hidden res-bg-warm">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600210492493-0946911123ea?auto=format&fit=crop&w=1440&q=60"
        alt={`Homes in ${city.name}, ${city.state}`}
        class="w-full h-full object-cover opacity-25"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(255,255,255,0.82) 0%, rgba(255,255,255,0.62) 50%, rgba(255,255,255,0.95) 100%);"></div>
      <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>
    </div>

    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 flex flex-col items-center text-center">
      <nav class="text-[11px] res-text-slate mb-5 md:mb-6 flex items-center gap-2 flex-wrap justify-center font-semibold tracking-wider uppercase" aria-label="Breadcrumb">
        <a href="/residential/" class="hover:opacity-70 res-text-slate no-underline transition-opacity">Residential</a>
        <span class="opacity-50">/</span>
        <span class="res-text-ink">{city.name}</span>
      </nav>

      <div class="mb-4 md:mb-7 flex items-center gap-3 animate-fade-in-up opacity-0" style="animation-delay: 0ms;">
        <div class="w-2 h-2 rounded-full bg-[var(--color-sage-deep)] animate-pulse"></div>
        <span class="font-bold text-[10px] md:text-xs tracking-[0.3em] uppercase res-text-sage">Serving {city.name}, {city.state}</span>
      </div>

      <h1 class="text-[2rem] md:text-[3.5rem] lg:text-[4.5rem] font-black leading-[0.88] tracking-tighter res-text-ink mb-6 md:mb-10 animate-fade-in-up opacity-0 uppercase drop-shadow-sm" style="animation-delay: 100ms;">
        Clean Air for<br />
        Your <span class="res-text-sage">{city.name}</span><br class="hidden md:inline" />
        <span class="res-text-sage">Home.</span>
      </h1>

      <p class="text-[14px] md:text-lg res-text-slate max-w-2xl leading-relaxed font-light mb-8 md:mb-14 opacity-0 animate-fade-in-up" style="animation-delay: 200ms;">
        Whole home duct cleaning, indoor air quality, and preventive maintenance for homeowners in {city.name}, {city.state}. We are the only NADCA certified company in Schuylkill County. {res.positioning.heroLine}
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 animate-fade-in-up opacity-0 w-full justify-center" style="animation-delay: 300ms;">
        <a
          href="#city-quote"
          class="res-btn-primary inline-flex items-center justify-center gap-3 font-bold tracking-widest text-xs py-4 md:py-[18px] px-8 md:px-10 rounded-sm w-full sm:w-auto sm:min-w-[240px] uppercase no-underline"
        >
          {res.ctaLabel}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href={`tel:${res.phoneRaw}`}
          class="hidden sm:flex items-center justify-center gap-3 px-10 py-[18px] bg-white border-2 res-text-ink font-bold text-xs tracking-widest uppercase hover:bg-[var(--color-sage-deep)] hover:text-white transition-all rounded-sm min-w-[240px] shadow-md no-underline group"
          style="border-color: var(--color-sage-deep);"
        >
          Call {res.phone}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="res-text-sage group-hover:text-white transition-colors"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICES AVAILABLE — commercial card geometry
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-10 lg:px-16">
      <div class="text-center mb-14">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          What we do in {city.name}
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Services Available Locally.
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-5">
        {res.services.map((s) => (
          <a
            href={`/residential/${s.slug}/`}
            class="group relative rounded-xl p-6 pt-7 transition-all duration-300 h-full flex flex-col no-underline overflow-hidden hover:-translate-y-1.5 bg-white border border-[var(--color-warm-line)] hover:border-[var(--color-sage-deep)]/30 shadow-[0_2px_16px_rgba(38,90,74,0.06)] hover:shadow-[0_16px_40px_rgba(38,90,74,0.14)]"
          >
            <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[var(--color-sage)] to-[var(--color-sage-deep)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <div class="relative z-10 mb-5 w-11 h-11 rounded-lg flex items-center justify-center transition-colors duration-300" style="background-color: rgba(167, 215, 197, 0.25); color: var(--color-sage-deep);">
              <Fragment set:html={residentialServiceIcons[s.id] || residentialServiceIcons['maintenance-plans']} />
            </div>

            <h3 class="relative z-10 text-[15px] font-extrabold uppercase tracking-tight leading-snug res-text-ink mb-2.5">
              {s.title}
            </h3>
            <p class="relative z-10 text-[13px] res-text-slate leading-relaxed flex-grow">
              {s.shortDescription}
            </p>

            <div class="relative z-10 mt-6 pt-4 border-t border-[var(--color-warm-line)] flex items-center font-bold text-[11px] uppercase tracking-widest res-text-sage transition-colors duration-300">
              <span>Learn More</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-auto opacity-40 group-hover:opacity-90 transition-all duration-300 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       LOCAL MAP + COPY
       ═══════════════════════════════════════════════════════════════ -->
  <section class="res-bg-warm py-14 md:py-18">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Where we work
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          On the Ground in {city.name}.
        </h2>
        <div class="w-20 h-1 mb-6 rounded-full" style="background-color: var(--color-sage-deep); opacity: 0.4;"></div>
        <p class="text-base md:text-lg leading-relaxed res-text-slate max-w-md mb-5">
          We serve {city.name} and the rest of Schuylkill County with preventive duct cleaning and indoor air quality work. We know what is in the houses around here because we live in them too. We typically respond within a few days, and our hours follow the listing on our Google Business Profile.
        </p>
        <p class="text-sm res-text-slate">
          Based in Pine Grove. <a href={`tel:${res.phoneRaw}`} class="res-text-sage font-bold hover:underline">{res.phone}</a>
        </p>
      </div>
      <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-md res-bg-surface border res-border-cream">
        <iframe
          src={`https://www.google.com/maps?q=${encodeURIComponent(`${city.name}, ${city.state}`)}&output=embed`}
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map of ${city.name}, ${city.state}`}
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       WHY LOCALS TRUST US — commercial cards
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-10">
      <div class="text-center mb-14 max-w-3xl mx-auto">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Why {city.name} homeowners call us
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Local Techs. Local Trucks.<br/>Real Answers.
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { num: '01', title: 'We Live Here Too', body: `Family run out of Pine Grove. Our crews live, work, and raise kids in Schuylkill County, the same county we serve. When you need clean air at your home in ${city.name}, you reach a neighbor.` },
          { num: '02', title: 'A Real Person Picks Up', body: 'You call (570) 900-5827 and a human in Pine Grove answers. No phone tree, no overseas call center, no callback queue measured in days.' },
          { num: '03', title: 'Only NADCA Certified in the County', body: 'We are the only NADCA certified company in Schuylkill County. We bring commercial grade restoration and indoor air quality discipline to your home. Source removal, HEPA containment, and lab verified sampling.' },
        ].map((d) => (
          <div class="group relative rounded-xl p-7 bg-white border border-[var(--color-warm-line)] transition-all duration-300 hover:-translate-y-1.5 hover:border-[var(--color-sage-deep)]/30 hover:shadow-[0_14px_30px_-12px_rgba(38,90,74,0.14)] overflow-hidden">
            <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[var(--color-sage)] to-[var(--color-sage-deep)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-3xl font-black res-text-sage mb-3 tracking-tight">{d.num}</div>
            <h3 class="font-extrabold text-lg uppercase tracking-tight res-text-ink mb-2.5">{d.title}</h3>
            <p class="text-base res-text-slate leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       REVIEWS
       ═══════════════════════════════════════════════════════════════ -->
  <!-- TODO: config has 2 of 3 Google reviews; add the 3rd verbatim when available -->
  <section class="res-bg-warm py-14 md:py-18">
    <div class="max-w-6xl mx-auto px-6 md:px-10">
      <div class="text-center mb-14">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          What neighbors are saying
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          From Homeowners Near {city.name}.
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {reviews.map((r) => (
          <div class="rounded-xl p-7 bg-white border border-[var(--color-warm-line)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sage-deep)]/30 hover:shadow-[0_14px_30px_-12px_rgba(38,90,74,0.14)]">
            <div class="flex gap-1 mb-4" style="color: var(--color-sage-deep);">
              {Array.from({ length: r.rating }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-base leading-relaxed res-text-slate italic mb-5">&ldquo;{r.quote}&rdquo;</p>
            <p class="text-sm font-bold res-text-ink uppercase tracking-[0.12em]">{r.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       FAQ — border-left commercial pattern
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative res-bg-cream py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-light"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="text-center mb-10 md:mb-12">
        <span class="inline-block font-bold text-[10px] tracking-[0.22em] uppercase mb-4 res-text-sage">
          Common questions
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5">
          Questions From {city.name}<br/>Homeowners.
        </h2>
        <div class="w-24 h-1 mx-auto opacity-40 rounded-full" style="background-color: var(--color-sage-deep);"></div>
      </div>
      <div class="space-y-10 md:space-y-12">
        {faq.map((q) => (
          <details class="group border-l-2 pl-6 md:pl-8" style="border-color: rgba(38, 90, 74, 0.4);">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
              <h3 class="text-lg md:text-xl font-bold res-text-ink leading-snug">{q.question}</h3>
              <span class="res-text-sage flex-shrink-0 text-xl leading-none mt-1 transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="res-text-slate text-base md:text-lg leading-relaxed mt-4">{q.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       BOTTOM CTA — two columns, embedded form
       ═══════════════════════════════════════════════════════════════ -->
  <section id="city-quote" class="relative res-bg-warm py-14 md:py-18 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] site-grid-dots"></div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-12 lg:px-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

        <div class="flex flex-col space-y-7">
          <div>
            <span class="font-bold text-[10px] tracking-[0.22em] uppercase mb-4 block res-text-sage">
              Ready when you are
            </span>
            <h2 class="text-4xl md:text-5xl lg:text-[54px] font-black uppercase tracking-tighter res-text-ink leading-[0.95] mb-5 max-w-xl">
              Need Help With Your<br/>{city.name} Home?
            </h2>
            <p class="res-text-slate text-base md:text-lg leading-relaxed max-w-xl">
              Schedule whole home duct cleaning, indoor air quality work, or a preventive maintenance visit for your {city.name} home. Tell us what you are after and we will give you a straight answer, a free estimate, and a real date we can be there.
            </p>
          </div>

          <ul class="space-y-5 mt-1">
            {[
              { title: 'Within a Few Days', description: 'We typically respond within a few days, and our hours follow the listing on our Google Business Profile.' },
              { title: 'Only NADCA Certified in the County', description: 'We are the only NADCA certified company in Schuylkill County. Commercial grade air care discipline, applied to your home.' },
              { title: 'Free Estimates, Clear Pricing', description: 'Estimates are free. We tell you what we find and give you a straight price before any work begins.' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-7 h-7 rounded-full flex items-center justify-center mt-1 flex-shrink-0" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <p class="res-text-ink text-sm font-bold uppercase tracking-[0.14em]">{item.title}</p>
                  <p class="res-text-slate text-sm md:text-base leading-relaxed mt-1">{item.description}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3 mt-2">
            <div class="p-2.5 rounded-full" style="background-color: rgba(167, 215, 197, 0.4); color: var(--color-sage-deep);">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] uppercase tracking-[0.28em] res-text-slate font-semibold">Direct Line</span>
              <a href={`tel:${res.phoneRaw}`} class="text-sm font-bold res-text-ink hover:res-text-sage transition-colors">{res.phone}</a>
            </div>
          </div>
        </div>

        <div class="w-full lg:max-w-xl lg:ml-auto">
          <div class="res-bg-surface border res-border-cream rounded-lg p-6 md:p-8 shadow-[0_24px_60px_-24px_rgba(38,90,74,0.20)]">
            <div class="h-1 w-16 rounded-full mb-4" style="background-color: var(--color-sage-deep);"></div>
            <div class="mb-6">
              <h3 class="res-text-ink font-bold text-base uppercase tracking-[0.12em]">
                Free Estimate Request
              </h3>
              <p class="res-text-slate text-xs md:text-sm mt-2 leading-relaxed">
                Serving <span class="font-semibold res-text-ink">{city.name}, {city.state}</span>
              </p>
            </div>

            <form name={`residential-${city.slug}-quote`} method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value={`residential-${city.slug}-quote`} />
              <input type="hidden" name="city" value={`${city.name}, ${city.state}`} />
              <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

              <div class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="lc-name" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Full Name *</label>
                    <input type="text" id="lc-name" name="name" required placeholder="Jane Smith" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                  <div class="space-y-1.5">
                    <label for="lc-phone" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Phone *</label>
                    <input type="tel" id="lc-phone" name="phone" required placeholder="(570) 555-1234" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="lc-email" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Email</label>
                  <input type="email" id="lc-email" name="email" placeholder="jane@example.com" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400" />
                </div>

                <div class="space-y-1.5">
                  <label for="lc-service" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Service Needed</label>
                  <select id="lc-service" name="service" class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all">
                    <option value="">Choose one</option>
                    {res.services.map((s) => (
                      <option value={s.slug}>{s.title}</option>
                    ))}
                    <option value="not-sure">Not sure yet</option>
                  </select>
                </div>

                <div class="space-y-1.5">
                  <label for="lc-message" class="res-text-slate text-[10px] font-semibold uppercase tracking-widest">Message</label>
                  <textarea id="lc-message" name="message" rows="4" placeholder={`Tell us what is happening with your ${city.name} home.`} class="w-full bg-white border res-border-cream rounded res-text-ink px-4 py-3 text-sm focus:outline-none focus:border-[var(--color-sage-deep)] focus:ring-1 focus:ring-[var(--color-sage-deep)]/20 transition-all placeholder:text-gray-400 resize-none"></textarea>
                </div>
              </div>

              <div class="mt-6">
                <button type="submit" class="res-btn-primary w-full px-8 py-4 rounded-sm font-bold tracking-[0.22em] uppercase text-sm">
                  {res.ctaLabel}
                </button>
              </div>
            </form>

            <p class="text-[10px] res-text-slate mt-4 leading-relaxed">
              No spam, no pressure pitch, no auto reply chain. A real person reads every message.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</ResidentialLayout>
