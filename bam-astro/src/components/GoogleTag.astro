---
/** GA4 tag, deferred to idle to keep TBT down. Shared by BaseLayout and ResidentialLayout. */
---
<!-- Google tag (gtag.js), deferred to reduce TBT -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XTWR3JMEFN');
  (function(){
    function loadGA(){
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XTWR3JMEFN';
      s.async = true;
      document.head.appendChild(s);
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGA, { timeout: 3000 });
    } else {
      setTimeout(loadGA, 3000);
    }
  })();
</script>
