---
/**
 * QuoteForm — the lead form inside QuoteDrawer. Carries every field from the
 * long forms (commercial = /contact/, residential = the residential bottom
 * quote form) with the same field names, so BAM OPS maps them the same way.
 */
import { siteConfig } from '../config/site.config';

interface Props {
  variant?: 'commercial' | 'residential';
}
const { variant = 'commercial' } = Astro.props;
const isResidential = variant === 'residential';

const formName = isResidential ? 'residential-drawer-quote' : 'site-visit-drawer';
const submitLabel = isResidential ? 'Get a Free Estimate' : 'Request Site Visit';

// Same options and values as the /contact/ form
const facilityTypes = [
  ['healthcare', 'Healthcare / Hospital'],
  ['education', 'Education (K-12 / Higher Ed)'],
  ['government', 'Government / Secure Facility'],
  ['industrial', 'Industrial / Manufacturing'],
  ['commercial', 'Commercial Real Estate'],
  ['data-center', 'Data Center'],
  ['senior-care', 'Senior Living / Assisted Living'],
  ['food-processing', 'Food Processing'],
  ['cold-storage', 'Cold Storage / Refrigeration'],
  ['lab', 'Lab / Life Sciences'],
  ['retail', 'Retail / Multi-Site'],
  ['other', 'Other'],
];
const inquiryTypes = [
  ['site-visit', 'Site Visit'],
  ['quote', 'Quote'],
  ['emergency', 'Emergency Service'],
  ['general', 'General Inquiry'],
];
const residentialServices = siteConfig.residential?.services ?? [];

const field = isResidential
  ? 'w-full bg-white border res-border-cream rounded-sm px-3.5 py-2.5 text-base md:text-sm res-text-ink placeholder:text-gray-400 focus:outline-none focus:border-[var(--color-sage-deep)] transition-colors'
  : 'w-full bg-white/[0.06] border border-white/15 rounded-sm px-3.5 py-2.5 text-base md:text-sm text-white placeholder:text-white/40 focus:outline-none focus:border-mint transition-colors';
const selectCls = isResidential ? 'cursor-pointer' : 'cursor-pointer [&>option]:bg-dark [&>option]:text-white';
const submit = isResidential
  ? 'w-full inline-flex items-center justify-center gap-2 rounded-sm bg-[var(--color-sage-deep)] text-white font-bold text-xs tracking-[0.18em] uppercase px-6 py-3.5 hover:opacity-90 transition-opacity'
  : 'w-full inline-flex items-center justify-center gap-2 rounded-sm bg-primary text-white font-bold text-xs tracking-[0.18em] uppercase px-6 py-3.5 hover:bg-mint hover:text-primary transition-colors';
const fine = isResidential ? 'res-text-slate' : 'text-white/45';
const checkText = isResidential ? 'res-text-slate' : 'text-white/70';
---

<form
  name={formName}
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="flex flex-col gap-2.5"
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

  {isResidential ? (
    <>
      <input type="hidden" name="inquiry_type" value="quote" />
      <label class="sr-only" for="qd-residential-name">Full Name</label>
      <input id="qd-residential-name" type="text" name="name" required autocomplete="name" placeholder="Full Name *" class={field} />

      <div class="grid grid-cols-2 gap-2.5">
        <label class="sr-only" for="qd-residential-phone">Phone</label>
        <input id="qd-residential-phone" type="tel" name="phone" required autocomplete="tel" placeholder="Phone *" class={field} />
        <label class="sr-only" for="qd-residential-email">Email</label>
        <input id="qd-residential-email" type="email" name="email" autocomplete="email" placeholder="Email" class={field} />
      </div>

      <label class="sr-only" for="qd-residential-service">Service Needed</label>
      <select id="qd-residential-service" name="service" class={`${field} ${selectCls}`}>
        <option value="">Service Needed</option>
        {residentialServices.map((s: any) => (
          <option value={s.slug}>{s.title}</option>
        ))}
        <option value="not-sure">Not sure yet</option>
      </select>

      <label class="sr-only" for="qd-residential-msg">Message</label>
      <textarea id="qd-residential-msg" name="describe_your_needs" rows="3" placeholder="Tell us a bit about your home and what you are looking for." class={`${field} resize-none`}></textarea>
    </>
  ) : (
    <>
      <div class="grid grid-cols-2 gap-2.5">
        <label class="sr-only" for="qd-commercial-name">Full Name</label>
        <input id="qd-commercial-name" type="text" name="name" required autocomplete="name" placeholder="Full Name *" class={field} />
        <label class="sr-only" for="qd-commercial-title">Title or Role</label>
        <input id="qd-commercial-title" type="text" name="job_title" autocomplete="organization-title" placeholder="Title / Role" class={field} />
      </div>

      <div class="grid grid-cols-2 gap-2.5">
        <label class="sr-only" for="qd-commercial-email">Email</label>
        <input id="qd-commercial-email" type="email" name="email" required autocomplete="email" placeholder="Email *" class={field} />
        <label class="sr-only" for="qd-commercial-phone">Phone</label>
        <input id="qd-commercial-phone" type="tel" name="phone" autocomplete="tel" placeholder="Phone" class={field} />
      </div>

      <label class="sr-only" for="qd-commercial-org">Organization or Facility</label>
      <input id="qd-commercial-org" type="text" name="companyName" autocomplete="organization" placeholder="Organization / Facility" class={field} />

      <div class="grid grid-cols-2 gap-2.5">
        <label class="sr-only" for="qd-commercial-facility">Facility Type</label>
        <select id="qd-commercial-facility" name="facility_type" class={`${field} ${selectCls}`}>
          <option value="">Facility Type</option>
          {facilityTypes.map(([v, l]) => (
            <option value={v}>{l}</option>
          ))}
        </select>
        <label class="sr-only" for="qd-commercial-inquiry">Inquiry Type</label>
        <select id="qd-commercial-inquiry" name="inquiry_type" class={`${field} ${selectCls}`}>
          {inquiryTypes.map(([v, l]) => (
            <option value={v}>{l}</option>
          ))}
        </select>
      </div>

      <label class="sr-only" for="qd-commercial-msg">Describe Your Needs</label>
      <textarea id="qd-commercial-msg" name="describe_your_needs" rows="3" placeholder="Describe your current HVAC challenges, compliance concerns, or what you're looking for." class={`${field} resize-none`}></textarea>

      <label class="flex items-start gap-2.5 cursor-pointer">
        <input type="checkbox" name="on_site_auditor" value="yes" class="mt-0.5 w-4 h-4 accent-mint flex-shrink-0" />
        <span class={`text-[13px] leading-snug ${checkText}`}>I'd like an on-site auditor to assess my facility's HVAC systems and provide a documented report.</span>
      </label>
    </>
  )}

  <button type="submit" class={`${submit} mt-1`}>
    {submitLabel}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </button>
  <p class={`text-xs text-center ${fine}`}>
    {isResidential ? 'No obligation. Free home estimate.' : 'No obligation. We respond within one business day.'}
  </p>
</form>
