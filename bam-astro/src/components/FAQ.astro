---
/**
 * Shared FAQ section — accordion UI + FAQPage schema.
 * Site-wide standard. Pass faqs + optional copy.
 */
interface FAQItem { question: string; answer: string; }
interface Props {
  faqs: FAQItem[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** unique name so multiple FAQ groups on one page don't collide */
  name?: string;
  /** emit FAQPage JSON-LD. Set false when the page already passes faqData to
   *  BaseLayout/SEOHead (which emits its own) to avoid duplicate schema. */
  schema?: boolean;
}

const {
  faqs,
  eyebrow = 'Common Questions',
  title = 'Frequently Asked Questions',
  intro = 'Straight answers on how BAM serves mission-critical commercial and institutional facilities.',
  name = 'faq',
  schema = true,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section class="relative bg-dark overflow-hidden py-20 md:py-28">
  <div class="absolute inset-0 opacity-[0.04] site-grid-dots"></div>
  <div class="absolute top-0 right-0 w-[700px] h-[500px] pointer-events-none" style="background: radial-gradient(ellipse at top right, rgba(167,215,197,0.07), transparent 70%);"></div>

  <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-12 lg:px-24">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-10 lg:gap-16 items-start">

      <!-- Intro column -->
      <div class="lg:sticky lg:top-28">
        <span class="inline-block text-mint font-bold text-xs tracking-[0.3em] uppercase mb-4">{eyebrow}</span>
        <h2 class="text-4xl md:text-5xl font-black text-white tracking-tighter uppercase leading-[0.9] mb-6">
          {title}
        </h2>
        <p class="text-light-grey text-[15px] leading-relaxed mb-7 max-w-xs">
          {intro}
        </p>
        <a href="/contact/" class="inline-flex items-center gap-2 text-mint font-bold text-xs uppercase tracking-[0.18em] hover:gap-3 transition-all no-underline">
          Have a different question? Ask us
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Accordion column -->
      <div class="divide-y divide-mint/10 border-t border-mint/10">
        {faqs.map((faq, i) => (
          <details class="group" name={name}>
            <summary class="flex items-start gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <span class="shrink-0 mt-0.5 text-mint/40 font-black text-sm tabular-nums w-6">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="flex-grow text-base md:text-lg font-bold text-white leading-snug transition-colors group-hover:text-mint group-open:text-mint">{faq.question}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1 text-mint/60 transition-transform duration-300 group-open:rotate-45"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </summary>
            <p class="text-light-grey text-[15px] leading-relaxed pb-6 pl-10 pr-2 -mt-1">{faq.answer}</p>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
