---
/**
 * QuoteDrawer — slide-in opt-in form. Mount ONCE per page: commercial in
 * BaseLayout, residential in ResidentialLayout. Any element with
 * `data-open-quote` opens it; keep the element's real href (usually
 * /contact/) as the no-JS fallback.
 *
 * Form sits at the top; the BAM badge fills the remaining height and shrinks
 * first. The panel only scrolls on screens too short for the form itself.
 */
import QuoteForm from './QuoteForm.astro';

interface Props {
  variant?: 'commercial' | 'residential';
}
const { variant = 'commercial' } = Astro.props;
const isResidential = variant === 'residential';

const heading = isResidential ? 'Get a Free Home Estimate' : 'Request a Site Visit';
const blurb = isResidential
  ? 'A real person reads every message and calls you back.'
  : 'Tell us about your facility and we will reach out to schedule an on-site assessment.';

const panel = isResidential ? 'res-bg-surface' : 'bg-dark border-l border-white/10';
const closeBtn = isResidential ? 'res-text-slate hover:opacity-70' : 'text-white/50 hover:text-white';
const titleText = isResidential ? 'res-text-ink' : 'text-white';
const blurbText = isResidential ? 'res-text-slate' : 'text-white/60';
const eyebrowText = isResidential ? 'res-text-sage' : 'text-mint';
---

<div
  id="quote-drawer-root"
  class="pointer-events-none fixed inset-0 z-[9999]"
  data-open="false"
  aria-hidden="true"
  inert
>
  <button
    type="button"
    id="quote-drawer-scrim"
    class="absolute inset-0 bg-black/55 opacity-0 transition-opacity duration-300"
    aria-label="Close form"
    tabindex="-1"
  ></button>

  <aside
    id="quote-drawer-panel"
    data-theme={isResidential ? 'residential' : undefined}
    role="dialog"
    aria-modal="true"
    aria-labelledby="quote-drawer-title"
    class={`absolute right-0 top-0 h-[100svh] w-full max-w-[420px] translate-x-full overflow-y-auto overscroll-contain shadow-2xl transition-transform duration-300 ease-out flex flex-col ${panel}`}
  >
    <button
      type="button"
      id="quote-drawer-close"
      class={`absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center transition-colors ${closeBtn}`}
      aria-label="Close"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="flex-shrink-0 px-6 sm:px-8 pt-8 pb-4">
      <p class={`text-[10px] font-bold uppercase tracking-[0.22em] mb-2 pr-10 ${eyebrowText}`}>
        {isResidential ? 'Schuylkill County Homeowners' : 'Building & Air Maintenance'}
      </p>
      <p id="quote-drawer-title" class={`text-2xl font-black uppercase tracking-tight leading-none mb-2 ${titleText}`}>{heading}</p>
      <p class={`text-sm leading-snug mb-4 ${blurbText}`}>{blurb}</p>
      <QuoteForm variant={variant} />
    </div>

    <!-- Large brand mark fills whatever height is left; shrinks first on short screens -->
    <div class="flex-1 min-h-[6rem] flex items-center justify-center px-8 pb-8">
      <img
        data-src="/images/bam-badge-lg.webp"
        alt="Building & Air Maintenance"
        width="640"
        height="640"
        decoding="async"
        class="h-full max-h-[20rem] w-auto max-w-full object-contain"
      />
    </div>
  </aside>
</div>

<script>
  const root = document.getElementById('quote-drawer-root');
  const panel = document.getElementById('quote-drawer-panel');
  const scrim = document.getElementById('quote-drawer-scrim');
  const closeBtn = document.getElementById('quote-drawer-close');
  let lastFocused: HTMLElement | null = null;

  function setOpen(open: boolean) {
    if (!root || !panel || !scrim) return;
    root.dataset.open = String(open);
    root.setAttribute('aria-hidden', String(!open));
    root.toggleAttribute('inert', !open);
    root.classList.toggle('pointer-events-none', !open);
    scrim.classList.toggle('opacity-0', !open);
    panel.classList.toggle('translate-x-full', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      panel.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
      setTimeout(() => panel.querySelector<HTMLElement>('input:not([type=hidden]):not([name=bot-field])')?.focus(), 250);
    } else {
      lastFocused?.focus();
    }
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open-quote]');
    if (!trigger || !root) return;
    e.preventDefault();
    lastFocused = trigger;
    setOpen(true);
  });
  scrim?.addEventListener('click', () => setOpen(false));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root?.dataset.open === 'true') setOpen(false);
  });
</script>
