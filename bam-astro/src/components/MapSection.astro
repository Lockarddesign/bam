---
/**
 * Shared location/map section — full-bleed grayscale Google map (color on
 * hover) with a dark info card pinned left. Site-wide standard.
 * Location pages MUST pass their own city-specific embedUrl + locationLabel.
 */
import { siteConfig } from '../config/site.config';

interface Props {
  /** Google Maps embed iframe src. Defaults to BAM HQ (Pine Grove, PA). */
  embedUrl?: string;
  /** Location line shown in the card. */
  locationLabel?: string;
  /** Accessible iframe title. */
  mapTitle?: string;
}

const {
  embedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3030.7623162795066!2d-76.3052182239814!3d40.568925771415415!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c5fb2055fd4e95%3A0x59bd5e1a24dfd2c6!2sBuilding%20and%20Air%20Maintenance%2C%20LLC!5e0!3m2!1sen!2sus!4v1780503212406!5m2!1sen!2sus',
  locationLabel = 'Pine Grove, PA',
  mapTitle = 'Building and Air Maintenance, LLC — Pine Grove, PA',
} = Astro.props;
---

<section class="group relative w-full leading-none bg-dark overflow-hidden">
  <iframe
    src={embedUrl}
    width="100%"
    height="520"
    class="w-full h-[520px] block grayscale contrast-[1.1] group-hover:grayscale-0 group-hover:contrast-100 transition-[filter] duration-500"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={mapTitle}
  ></iframe>

  <!-- Info card: pinned bottom on mobile, full-height left on desktop -->
  <div class="absolute z-10 bg-dark shadow-[16px_0_48px_rgba(0,0,0,0.3)] flex flex-col justify-center
              left-0 right-0 bottom-0 border-t border-white/10 px-6 py-6
              sm:top-0 sm:right-auto sm:w-[clamp(300px,28vw,380px)] sm:border-t-0 sm:border-r sm:px-9 sm:py-10">
    <div class="flex items-center gap-3 pb-4 mb-5 border-b border-white/10">
      <img src="/bam-logo.webp" alt="BAM — Building & Air Maintenance" width="36" height="36" class="h-9 w-auto object-contain" />
      <span class="flex flex-col leading-tight">
        <strong class="text-white font-extrabold text-sm tracking-[0.06em] uppercase">Building &amp; Air</strong>
        <span class="text-white/55 font-semibold text-[10px] tracking-[0.14em] uppercase">Maintenance, LLC</span>
      </span>
    </div>

    <div class="flex flex-col gap-3 mb-5">
      <div class="flex items-center gap-2.5 text-white/80 text-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mint shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        {locationLabel}
      </div>
      <div class="flex items-center gap-2.5 text-white/80 text-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mint shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <a href={`tel:${siteConfig.phoneRaw}`} class="hover:text-white transition-colors no-underline">{siteConfig.phone}</a>
      </div>
      <div class="flex items-center gap-2.5 text-white/80 text-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mint shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Serving PA, NJ, MD, DE &amp; Southern NY
      </div>
    </div>

    <a href="https://www.google.com/maps/dir/?api=1&destination=Building+and+Air+Maintenance,+LLC" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full px-5 py-3 bg-mint text-primary rounded-full text-sm font-bold hover:bg-white transition-all no-underline">
      Get Directions
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
    </a>

    <div class="flex items-center justify-center gap-1 mt-4">
      <svg viewBox="0 0 24 24" fill="#F5A623" width="17" height="17"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <svg viewBox="0 0 24 24" fill="#F5A623" width="17" height="17"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <svg viewBox="0 0 24 24" fill="#F5A623" width="17" height="17"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <svg viewBox="0 0 24 24" fill="#F5A623" width="17" height="17"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <svg viewBox="0 0 24 24" fill="#F5A623" width="17" height="17"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span class="text-white/55 text-xs font-semibold ml-1.5">5.0 on Google</span>
    </div>
  </div>
</section>
